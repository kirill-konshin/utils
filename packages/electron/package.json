{
  "name": "@kirill.konshin/electron",
  "description": "Utilities",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "----- BUILD -----": "",
    "clean": "rm -rf dist .tscache tsconfig.tsbuildinfo",
    "build": "vite build",
    "start": "yarn build --watch",
    "wait": "wait-on ./dist/index.js",
    "----- TEST -----": "",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "----- STORYBOOK -----": "",
    "storybook:start": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "electron-default-menu": "^1.0.2",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@kirill.konshin/utils-private": "*",
    "electron": "^43.4.0"
  },
  "peerDependencies": {
    "electron": "^43"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Kirill Konshin <kirill@konshin.org> (https://konshin.org)",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirill-konshin/utils.git",
    "directory": "packages/electron"
  },
  "nx": {
    "tags": [
      "platform:electron"
    ]
  },
  "files": [
    "dist"
  ]
}
