{
  "name": "@kirill.konshin/icons",
  "description": "All FontAwesome and Gravity UI icons re-exported from one package, tree-shakeable via optimizePackageImports",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "----- BUILD -----": "",
    "clean": "rm -rf dist .tscache tsconfig.tsbuildinfo",
    "build": "vite build",
    "build:index": "cti create ./src",
    "build:check-types": "attw --pack .",
    "start": "yarn build --watch",
    "wait": "wait-on ./dist/index.js",
    "----- TEST -----": "",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "----- STORYBOOK -----": "",
    "storybook:start": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@gravity-ui/icons": "^2.21.0"
  },
  "devDependencies": {
    "@kirill.konshin/utils-private": "*",
    "react": "^19.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Kirill Konshin <kirill@konshin.org> (https://konshin.org)",
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirill-konshin/utils.git",
    "directory": "packages/icons"
  },
  "nx": {
    "tags": [
      "platform:react"
    ]
  },
  "files": [
    "dist"
  ]
}
