{
  "name": "@kirill.konshin/mui",
  "description": "Utilities",
  "version": "0.0.0",
  "type": "module",
  "hasStorybook": true,
  "scripts": {
    "----- BUILD -----": "",
    "clean": "rm -rf dist .tscache tsconfig.tsbuildinfo",
    "build": "vp pack",
    "start": "yarn build --watch",
    "wait": "wait-on ./dist/index.js",
    "----- TEST -----": "",
    "test": "vp test run --coverage",
    "test:watch": "vp test watch --coverage",
    "----- STORYBOOK -----": "",
    "storybook:start": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@toolpad/core": "0.16.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@kirill.konshin/auth": "*",
    "@kirill.konshin/utils-private": "*",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^30.0.1",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "19.2.8"
  },
  "peerDependencies": {
    "@kirill.konshin/auth": "*",
    "@mui/icons-material": "^9",
    "@mui/material": "^9",
    "next": "^16",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "@kirill.konshin/auth": {
      "optional": true
    },
    "@mui/icons-material": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Kirill Konshin <kirill@konshin.org> (https://konshin.org)",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./toolpad": {
      "types": "./dist/toolpad/index.d.ts",
      "import": "./dist/toolpad/index.js",
      "default": "./dist/toolpad/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirill-konshin/utils.git",
    "directory": "packages/mui"
  },
  "nx": {
    "tags": [
      "platform:next"
    ]
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "tanstack-intent"
  ]
}
