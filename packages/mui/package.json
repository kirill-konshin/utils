{
  "name": "@kirill.konshin/mui",
  "description": "Utilities",
  "version": "0.0.0",
  "type": "module",
  "hasStorybook": true,
  "scripts": {
    "----- BUILD -----": "",
    "clean": "rm -rf dist .tscache tsconfig.tsbuildinfo",
    "build": "vite build",
    "start": "yarn build --watch",
    "wait": "wait-on ./dist/index.js",
    "----- TEST -----": "",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "----- STORYBOOK -----": "",
    "storybook:start": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@kirill.konshin/auth": "*",
    "@kirill.konshin/utils-private": "*",
    "@mui/material": "^9.3.1",
    "@toolpad/core": "^0.16.0",
    "next": "^16.3.0",
    "react": "^19.2.8"
  },
  "peerDependencies": {
    "@kirill.konshin/auth": "*",
    "@mui/material": "^9",
    "@toolpad/core": "^0.16",
    "next": "^16",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "@kirill.konshin/auth": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    },
    "@toolpad/core": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Kirill Konshin <kirill@konshin.org> (https://konshin.org)",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirill-konshin/utils.git",
    "directory": "packages/mui"
  },
  "nx": {
    "tags": [
      "platform:next"
    ]
  },
  "files": [
    "dist"
  ]
}
