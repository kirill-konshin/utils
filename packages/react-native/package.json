{
  "name": "@kirill.konshin/react-native",
  "description": "Utilities",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "----- BUILD -----": "",
    "clean": "rm -rf dist .tscache tsconfig.tsbuildinfo",
    "build": "vite build",
    "start": "yarn build --watch",
    "wait": "wait-on ./dist/index.js",
    "----- TEST -----": "",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "----- STORYBOOK -----": "",
    "storybook:start": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "expo-file-system": "^57.0.2",
    "expo-sharing": "^57.0.11",
    "expo-updates": "^57.0.13"
  },
  "devDependencies": {
    "@kirill.konshin/utils-private": "*",
    "react": "^19.2.8",
    "react-native": "^0.87.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-native": "^0.87"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Kirill Konshin <kirill@konshin.org> (https://konshin.org)",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirill-konshin/utils.git",
    "directory": "packages/react-native"
  },
  "nx": {
    "tags": [
      "platform:react-native"
    ]
  },
  "files": [
    "dist"
  ]
}
