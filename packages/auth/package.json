{
  "name": "@kirill.konshin/auth",
  "description": "Reusable iron-session authentication for Next.js App Router: session module, layout/page guards, route handler guards, proxy guard, password login",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "----- BUILD -----": "",
    "clean": "rm -rf dist .tscache tsconfig.tsbuildinfo",
    "build": "vite build",
    "build:index": "cti create ./src",
    "build:check-types": "attw --pack .",
    "start": "yarn build --watch",
    "wait": "wait-on ./dist/index.js",
    "----- TEST -----": "",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "----- STORYBOOK -----": "",
    "storybook:start": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "iron-session": "^8.0.4",
    "picomatch": "4.0.5"
  },
  "devDependencies": {
    "@kirill.konshin/utils-private": "*",
    "@types/picomatch": "^4.0.3",
    "next": "^16.2.12"
  },
  "peerDependencies": {
    "next": "^16"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Kirill Konshin <kirill@konshin.org> (https://konshin.org)",
  "license": "MIT",
  "exports": {
    "./client": {
      "import": {
        "import": "./dist/client/index.js",
        "types": "./dist/client/index.d.ts"
      }
    },
    ".": {
      "import": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirill-konshin/utils.git",
    "directory": "packages/auth"
  },
  "nx": {
    "tags": [
      "platform:next"
    ]
  },
  "files": [
    "dist"
  ]
}
