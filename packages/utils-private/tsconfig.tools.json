{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": ".tscache/tsconfig.tools.tsbuildinfo",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": ["node"]
  },
  "include": ["*.ts"],
  "exclude": []
}
