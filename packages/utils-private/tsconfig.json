{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "dist",
    "incremental": false,
    /* Build-specific options */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "isolatedDeclarations": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* TypeScript 6 no longer includes every @types package by default; Vite client types declare asset and CSS imports */
    "types": ["node", "vite-plus/client"]
  },
  "include": ["src"],
  "exclude": [],
  "references": [{ "path": "./tsconfig.tools.json" }]
}
