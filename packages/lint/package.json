{
  "name": "@kirill.konshin/lint",
  "description": "Vite+ (Oxlint + Oxfmt), ESLint + Prettier + lint-staged configs and AI agent rules/skills for monorepos",
  "version": "0.0.0",
  "type": "module",
  "skipGenerate": true,
  "bin": {
    "lint-prepare": "./dist/lintPrepare.js",
    "spec-tools": "./skills/spec-tools/scripts/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./lint-staged": {
      "types": "./dist/lintStaged.d.ts",
      "import": "./dist/lintStaged.js",
      "default": "./dist/lintStaged.js"
    },
    "./prettier": {
      "types": "./dist/prettier.d.ts",
      "import": "./dist/prettier.js",
      "default": "./dist/prettier.js"
    },
    "./vite-plus": {
      "types": "./dist/vitePlus.d.ts",
      "import": "./dist/vitePlus.js",
      "default": "./dist/vitePlus.js"
    },
    "./oxlint-plugin": {
      "types": "./dist/oxlintPlugin.d.ts",
      "import": "./dist/oxlintPlugin.js",
      "default": "./dist/oxlintPlugin.js"
    },
    "./yarn": {
      "types": "./dist/yarn.d.cts",
      "require": "./dist/yarn.cjs"
    }
  },
  "scripts": {
    "----- BUILD -----": "",
    "clean": "rm -rf dist skills/spec-tools/scripts",
    "build": "vp pack",
    "start": "vp pack --watch",
    "----- TEST -----": "",
    "test": "yarn build && vp test run"
  },
  "files": [
    "dist",
    "rules",
    "skills",
    "!**/*.test.*"
  ],
  "dependencies": {
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^10.0.1",
    "@manypkg/find-root": "^3.1.0",
    "@manypkg/get-packages": "^3.1.0",
    "@next/eslint-plugin-next": "^16.3.0",
    "@nx/eslint-plugin": "23.2.0-beta.7",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "@yarnpkg/types": "^4.0.1",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.5.7",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-turbo": "^2.10.9",
    "eslint-plugin-unicorn": "^73.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "^13.0.6",
    "globals": "^17.11.0",
    "jsonc-eslint-parser": "^3.3.0",
    "local-pkg": "^1.2.1",
    "path-scurry": "^2.0.2",
    "skills": "1.7.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/eslint-plugin-promise": "^7.3.0",
    "github-markdown-css": "^5.9.0",
    "lint-staged": "^17.3.0",
    "marked": "^18.0.5",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite-plus": "^1.3.0"
  },
  "peerDependencies": {
    "eslint": "^10",
    "husky": "^9",
    "jest": "^30",
    "lint-staged": "^16 || ^17",
    "next": "^16",
    "prettier": "^3",
    "storybook": "^10",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite": "^8 || ^1.3.0",
    "vite-plus": "^1.3.0",
    "vitest": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "husky": {
      "optional": true
    },
    "jest": {
      "optional": true
    },
    "lint-staged": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "storybook": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Kirill Konshin <kirill@konshin.org> (https://konshin.org)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirill-konshin/utils.git",
    "directory": "packages/lint"
  },
  "nx": {
    "tags": [
      "platform:tooling"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/skills/spec-tools/scripts"
        ]
      }
    }
  }
}
