{
  "name": "@kirill.konshin/utils-monorepo",
  "description": "Utils Monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "postinstall": "yarn postinstall:lint:build && yarn postinstall:lint && yarn postinstall:nx && yarn postinstall:husky",
    "postinstall:lint:build": "yarn nx run @kirill.konshin/lint:build",
    "postinstall:lint": "lint-prepare init",
    "postinstall:nx": "nx show projects > /dev/null",
    "postinstall:husky": "husky",
    "----- LINT -----": "",
    "eslint": "eslint --fix --concurrency=auto --cache --cache-location node_modules/.cache/eslint",
    "prettier": "prettier --write --log-level=warn --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "yarn eslint . && yarn prettier .",
    "lint:staged": "lint-staged --debug",
    "----- RELEASE -----": "",
    "release": "nx release",
    "release:preview": "nx release --dry-run --verbose",
    "commitlint": "commitlint",
    "----- TASKS -----": "",
    "start": "nx run-many -t start --parallel=100",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test --parallel=1",
    "serve": "nx run-many -t serve",
    "----- TASKS: PACKAGES ONLY -----": "",
    "start:packages": "yarn start --projects '@kirill.konshin/*'",
    "build:packages": "yarn build --projects '@kirill.konshin/*'",
    "----- TASKS: AFFECTED (CI) -----": "",
    "test:affected": "nx affected -t test --parallel=1 --exclude '@demo/*'",
    "build:affected": "nx affected -t build --exclude '@demo/*'"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@kirill.konshin/lint": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@yarnpkg/types": "^4.0.1",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nx": "23.2.0-beta.7",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0",
    "yalc": "^1.0.0-pre.53"
  },
  "author": "Kirill Konshin <kirill@konshin.org> (https://konshin.org)",
  "license": "MIT",
  "packageManager": "yarn@4.17.1",
  "workspaces": {
    "packages": [
      "demo/*",
      "packages/*"
    ]
  },
  "resolutions": {
    "@nx/eslint-plugin": "23.2.0-beta.7",
    "@nx/js": "23.2.0-beta.7",
    "nx": "23.2.0-beta.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kirill-konshin/utils.git"
  }
}
