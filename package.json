{
  "name": "@kirill.konshin/utils-monorepo",
  "description": "Utils Monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "postinstall": "node --run postinstall:lint:build && node --run postinstall:lint && node --run postinstall:nx && node --run postinstall:hooks",
    "postinstall:lint:build": "nx run @kirill.konshin/lint:build",
    "postinstall:lint": "lint-prepare init",
    "postinstall:nx": "nx show projects > /dev/null",
    "postinstall:hooks": "vp config",
    "----- LINT -----": "",
    "lint": "vp check --fix",
    "lint:staged": "vp staged",
    "----- RELEASE -----": "",
    "release": "nx release",
    "release:check": "node scripts/checkPackageBuilds.mjs",
    "release:preview": "nx release --dry-run --verbose",
    "commitlint": "commitlint",
    "----- TASKS -----": "",
    "start": "nx run-many -t start",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "serve": "nx run-many -t serve",
    "----- TASKS: PACKAGES ONLY -----": "",
    "start:packages": "yarn start --projects '@kirill.konshin/*'",
    "build:packages": "yarn build --projects '@kirill.konshin/*'",
    "----- TASKS: AFFECTED (CI) -----": "",
    "test:affected": "nx affected -t test --exclude '@demo/*'",
    "build:affected": "nx affected -t build --exclude '@demo/*'"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@kirill.konshin/lint": "workspace:*",
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@yarnpkg/types": "^4.0.1",
    "eslint": "^10.8.1",
    "nx": "23.2.0-beta.7",
    "react": "^19.2.8",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
    "vite-plus": "^1.3.0",
    "wait-on": "^9.1.0",
    "yalc": "^1.0.0-pre.53"
  },
  "author": "Kirill Konshin <kirill@konshin.org> (https://konshin.org)",
  "license": "MIT",
  "packageManager": "yarn@4.17.1",
  "workspaces": {
    "packages": [
      "demo/*",
      "packages/*"
    ]
  },
  "resolutions": {
    "@nx/eslint-plugin": "23.2.0-beta.7",
    "@nx/js": "23.2.0-beta.7",
    "nx": "23.2.0-beta.7",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kirill-konshin/utils.git"
  }
}
